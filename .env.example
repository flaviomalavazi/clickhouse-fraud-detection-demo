# ClickHouse Cloud connection settings
# Copy this file to .env and fill in the values from the ClickHouse Cloud
# console: your service -> Connect -> HTTPS.

# Required. Hostname only, no scheme and no port.
CLICKHOUSE_HOST=xxxxxxxxxx.<region>.<cloud>.clickhouse.cloud

# Required. The password shown when the service was created (or a reset one).
CLICKHOUSE_PASSWORD=<YOUR_PASSWORD>

# Optional. Defaults below match what the scripts assume when unset.
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_DATABASE=fraud
